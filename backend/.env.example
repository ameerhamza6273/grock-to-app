# Copy to .env and fill in
APP_NAME="Product Template Generator"
SECRET_KEY=change-me-to-a-random-string
DATABASE_URL=sqlite+aiosqlite:///./data/tool.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20
# Frontend origin(s) when the UI is hosted on another domain, comma-separated
CORS_ORIGINS=
# Later: your image generation API
IMAGE_GEN_API_URL=
IMAGE_GEN_API_KEY=
